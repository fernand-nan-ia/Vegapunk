# ── Obrigatórios ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=            # do @BotFather
OPENROUTER_API_KEY=            # openrouter.ai/keys
# IDs de chat autorizados, separados por vírgula. Deixe vazio na 1ª execução,
# mande /id ao bot para descobrir o seu, depois preencha.
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Opcionais ─────────────────────────────────────────────────
VEGAPUNK_MODEL=google/gemini-3.7-flash   # id do OpenRouter; mais barato: deepseek/deepseek-v4-flash
VEGAPUNK_WHISPER_MODEL=small   # tiny | base | small | medium (CPU: small é o equilíbrio)
VEGAPUNK_GIT_COMMIT=true       # commit automático no vault
VEGAPUNK_GIT_PUSH=false        # push automático (precisa de credencial git no container)
VEGAPUNK_COOKIES_FILE=         # cookies.txt (Netscape) para Instagram com login wall
VEGAPUNK_DB_PATH=data/vegapunk.db
VEGAPUNK_VAULT_DIR=knowledge
