# ── Obrigatórios ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
# IDs de chat autorizados, separados por vírgula. Deixe vazio na 1ª execução,
# mande /id ao bot para descobrir o seu, depois preencha.
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Opcionais ─────────────────────────────────────────────────
VEGAPUNK_MODEL=google/gemini-3.7-flash
VEGAPUNK_WHISPER_MODEL=small
VEGAPUNK_GIT_COMMIT=true
VEGAPUNK_GIT_PUSH=false
VEGAPUNK_COOKIES_FILE=
VEGAPUNK_DB_PATH=data/vegapunk.db
VEGAPUNK_VAULT_DIR=punk_records

# ── Multi-bot no grupo (v1.6.0 / v1.7.0) ───────────────────────────────
# Um token por Satélite. Ausente = aquele Satélite fala pela boca do Stella.
# TELEGRAM_BOT_TOKEN_SHAKA=
# TELEGRAM_BOT_TOKEN_LILITH=
# TELEGRAM_BOT_TOKEN_EDISON=
# TELEGRAM_BOT_TOKEN_PYTHAGORAS=
# TELEGRAM_BOT_TOKEN_ATLAS=
# TELEGRAM_BOT_TOKEN_YORK=

# Só estes ids de USUÁRIO disparam chamada paga, mesmo dentro de um chat autorizado.
# Vazio = qualquer participante do chat gasta sua chave do OpenRouter.
# Numa conversa privada, o id do chat é o id do usuário: reaproveite o de TELEGRAM_ALLOWED_CHAT_IDS.
TELEGRAM_ALLOWED_USER_IDS=6788553570

# O grupo só responde quando isto for true. Ausente ou false = grupo mudo,
# mesmo com o id dele em TELEGRAM_ALLOWED_CHAT_IDS.
# NUNCA ligue sem preencher TELEGRAM_ALLOWED_USER_IDS (condição do gate do Shaka).
VEGAPUNK_GROUP_ENABLED=true

# Modelo do roteador do grupo. Vazio = usa VEGAPUNK_MODEL.
VEGAPUNK_ROUTER_MODEL=

# Sem nome na mensagem: o roteador escolhe o dono pelo ASSUNTO (pode ser o próprio Stella).
# false volta ao comportamento original — mensagem sem nome fora da janela custa zero.
VEGAPUNK_GROUP_TRIAGE=true
