# ── Obrigatórios ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
# IDs de chat autorizados, separados por vírgula. Deixe vazio na 1ª execução,
# mande /id ao bot para descobrir o seu, depois preencha.
TELEGRAM_ALLOWED_CHAT_IDS=

# ── Opcionais ─────────────────────────────────────────────────
VEGAPUNK_MODEL=google/gemini-3.7-flash
VEGAPUNK_WHISPER_MODEL=small
VEGAPUNK_GIT_COMMIT=true
VEGAPUNK_GIT_PUSH=false
VEGAPUNK_COOKIES_FILE=
VEGAPUNK_DB_PATH=data/vegapunk.db
VEGAPUNK_VAULT_DIR=knowledge
